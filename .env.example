# Database
DATABASE_URL=postgresql://cardgame:cardgame_dev@localhost:5432/cardgame

# Redis
REDIS_URL=redis://localhost:6379

# Auth (NextAuth)
NEXTAUTH_URL=http://localhost:3000
# Set true behind Railway's HTTPS proxy.
AUTH_TRUST_HOST=false
NEXTAUTH_SECRET=your-secret-here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Server
SERVER_PORT=3001
WEB_URL=http://localhost:3000
JWT_SECRET=replace-with-a-separate-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Live audio and video (optional). With MEDIA_PROVIDER unset the call
# controls stay hidden and the card game is unaffected. See docs/MEDIA.md.
MEDIA_PROVIDER=none
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEDIA_TOKEN_TTL_SECONDS=300
